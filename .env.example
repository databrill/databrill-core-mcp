# ── Single-workspace mode ──────────────────────────────────────────────────
# Direct Postgres connection to the client's target DB. Used when DATABRILL_CONFIG
# is NOT set.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Announce the workspace-specific TFL inventory tool in single-workspace mode.
# Leave unset/false for workspaces without The Fulfillment Lab.
# DATABRILL_TFL_INVENTORY_ENABLED=true

# Announce the SQL read tools (executeSql, listTables, describeTable) in
# single-workspace mode. They run on whatever connection POSTGRES_URL names, so
# enable this only when that role is genuinely read-only: the guards here bound
# what a statement may consume and return, never what it may touch.
# DATABRILL_SQL_ENABLED=true

# Announce writeSql. A SEPARATE flag from the read tools on purpose, so a
# read-only session can offer the read tools and nothing else. What writeSql may
# modify is decided entirely by the grants on the role POSTGRES_URL connects as.
# DATABRILL_SQL_WRITE_ENABLED=true

# ── Multi-workspace mode ────────────────────────────────────────────────────
# Point at a JSON config (see databrill.config.example.json) to serve several
# client workspaces from one server. The config's ${VAR} placeholders are
# expanded from the variables below, so connection secrets stay here in .env.
# DATABRILL_CONFIG=./databrill.config.json
# WORKSPACE_A_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# WORKSPACE_B_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
