# Point at a JSON registry (see databrill.config.example.json). Every entry uses
# a different environment variable and that workspace's own provisioned role.
DATABRILL_CONFIG=./databrill.config.json
WORKSPACE_A_POSTGRES_URL=postgresql://WORKSPACE_A_ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
WORKSPACE_B_POSTGRES_URL=postgresql://WORKSPACE_B_ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
